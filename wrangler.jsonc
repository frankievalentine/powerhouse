// Base configuration: only what every deployment needs. Do not edit this file
// for your own deployment; put your settings and optional features in
// wrangler.local.jsonc (see wrangler.local.example.jsonc), which is merged
// over this file by config/merge-wrangler.ts.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "powerhouse",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  // No per-version preview hostnames: Access protects only the main hostname,
  // so every reachable hostname should be one Access covers.
  "preview_urls": false,
  // Workers AI runs remotely even in local dev, so dev usage bills your account.
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "not_found_handling": "single-page-application",
    // The MCP server and its OAuth endpoints are answered by the Worker, not the app shell.
    "run_worker_first": ["/agents/*", "/api/*", "/mcp", "/authorize", "/oauth/*", "/.well-known/*"]
  },
  // Grants and registered clients of MCP clients (Settings > Use from other
  // apps). No id: Wrangler creates the namespace on the first deploy.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // Org is the only top-level agent. JobAgent runs as an Org sub-agent (facet) and needs no binding.
  // Deployment keeps settings made in the browser (Finish setup), such as Access.
  // Access settings set by setup.mjs are vars in wrangler.local.jsonc instead,
  // and are deliberately not declared here: Deploy to Cloudflare would ask for them.
  "durable_objects": {
    "bindings": [
      { "class_name": "Org", "name": "Org" },
      { "class_name": "Deployment", "name": "DEPLOYMENT" }
    ]
  },
  "migrations": [
    { "new_sqlite_classes": ["Org"], "tag": "v1" },
    { "new_sqlite_classes": ["Deployment"], "tag": "v2" }
  ]
}
