// Base configuration: only what every deployment needs. Do not edit this file
// for your own deployment; put your settings and optional features in
// wrangler.local.jsonc (see wrangler.local.example.jsonc), which is merged
// over this file by config/merge-wrangler.ts.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "powerhouse",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  // No per-version preview hostnames: Access protects only the main hostname,
  // so every reachable hostname should be one Access covers.
  "preview_urls": false,
  // Workers AI runs remotely even in local dev, so dev usage bills your account.
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  "vars": {
    // Cloudflare Access: team domain (https://<team>.cloudflareaccess.com) and the
    // application AUD tag. The team name is also the org id: one org per Access team.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  // Org is the only top-level agent. JobAgent runs as an Org sub-agent (facet) and needs no binding.
  "durable_objects": {
    "bindings": [{ "class_name": "Org", "name": "Org" }]
  },
  "migrations": [{ "new_sqlite_classes": ["Org"], "tag": "v1" }]
}
