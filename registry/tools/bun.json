{
  "id": "bun",
  "title": "Bun",
  "description": "Fast JavaScript runtime and package manager used by powerhouse itself.",
  "kind": "runtime",
  "priority": 15,
  "supportedPlatforms": ["darwin", "linux", "win32", "wsl"],
  "check": {
    "command": "bun",
    "args": ["--version"]
  },
  "doctorHint": "Install Bun before running the powerhouse CLI locally.",
  "installs": {
    "darwin": [{ "type": "brew", "name": "bun" }],
    "linux": [{ "type": "brew", "name": "bun" }],
    "win32": [{ "type": "powershell-script", "url": "https://bun.sh/install.ps1" }]
  }
}
