{
  "id": "windsurf-sequential-thinking",
  "title": "Windsurf Sequential Thinking MCP",
  "description": "Structured multi-step reasoning server for Windsurf.",
  "serverName": "sequential-thinking",
  "targetAgents": ["windsurf"],
  "supportedPlatforms": ["darwin", "linux", "wsl"],
  "supportedScopes": ["global", "project"],
  "serverKind": "stdio",
  "source": "@modelcontextprotocol/server-sequential-thinking",
  "tags": ["reasoning", "thinking", "mcp"],
  "install": {
    "kind": "json-config",
    "scopePaths": {
      "global": "~/.codeium/windsurf/mcp_config.json",
      "project": ".codeium/windsurf/mcp_config.json"
    },
    "operations": [
      {
        "op": "set-object-entry",
        "path": ["mcpServers"],
        "key": "{{serverName}}",
        "value": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
        }
      }
    ],
    "restartRequired": true
  }
}
