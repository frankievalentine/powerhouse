  <script>
    const html     = document.documentElement;
    const btnDark  = document.getElementById('btn-dark')  as HTMLButtonElement;
    const btnLight = document.getElementById('btn-light') as HTMLButtonElement;

    function applyTheme(theme: string) {
      html.setAttribute('data-theme', theme);
      const isDark = theme === 'dark';
      btnDark.classList.toggle('is-active', isDark);
      btnLight.classList.toggle('is-active', !isDark);
      btnDark.setAttribute('aria-pressed', String(isDark));
      btnLight.setAttribute('aria-pressed', String(!isDark));
    }

    // Sync initial active state to whatever the inline script already set
    applyTheme(html.getAttribute('data-theme') ?? 'dark');

    btnDark.addEventListener('click', () => {
      applyTheme('dark');
      localStorage.setItem('ph-theme', 'dark');
    });

    btnLight.addEventListener('click', () => {
      applyTheme('light');
      localStorage.setItem('ph-theme', 'light');
    });

    // Keep in sync if OS preference changes and user hasn't overridden
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      if (!localStorage.getItem('ph-theme')) {
        applyTheme(e.matches ? 'dark' : 'light');
      }
    });
  </script>
