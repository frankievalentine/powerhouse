{
  "name": "powerhouse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "bun run cli setup",
    "bootstrap": "bun run cli setup",
    "cli": "bun packages/cli/src/index.ts",
    "doctor": "bun run cli doctor",
    "domains": "bun run cli domain list",
    "lint": "bun run typecheck && bun run web:lint",
    "harnesses": "bun run cli harness list",
    "docs:generate": "bun scripts/generate-docs.ts",
    "docs:generate:force": "bun scripts/generate-docs.ts --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "web:dev": "bun run --cwd apps/web dev",
    "web:lint": "bun run --cwd apps/web lint"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  }
}
